
location / {
    proxy_pass         http://promlens;
    proxy_http_version 1.1;

    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;

    # Always strip any client-supplied X-Remote-User header to prevent spoofing.
    # An empty value causes nginx to drop the header entirely before forwarding.
    proxy_set_header   X-Remote-User     "";

    # For cert auth mode only: uncomment the line below to inject the TLS client
    # certificate CN as the authenticated user. This overrides the empty value above.
    # Requires ssl_verify_client on; and ssl_client_certificate <ca.crt>; in the
    # server block.
    # proxy_set_header X-Remote-User $ssl_client_s_dn_cn;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}
